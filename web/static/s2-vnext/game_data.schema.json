{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2-vnext-game-data.schema.json",
  "title": "S2 vNext shared game definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gameVersion", "rules", "resources", "eras", "multiplierRegions", "upgrades", "strategy"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 3 },
    "gameVersion": { "type": "string", "minLength": 1 },
    "contentVersion": { "type": "string", "minLength": 1 },
    "playtestDays": { "type": "integer", "minimum": 1, "maximum": 120 },
    "rules": {
      "type": "object",
      "required": ["settlementMinutes", "baseCreditsPerMinute", "baseDepthPerMinute", "manualAutomationThreshold", "autoPurchaseIntervalMinutes", "autoPurchaseBudget", "autoReserveManualLevels", "randomAlgorithm", "randomSigma", "dailyUpgradeAuditMin", "dailyUpgradeAuditMax", "developmentTargetDepth", "helperIntervalMinutes", "baseCriticalDamage", "manualBurstWarningLevels", "batchCommandMaxLevels"],
      "properties": {
        "helperIntervalMinutes": { "const": 1440 },
        "baseCriticalDamage": { "type": "number", "minimum": 0 },
        "manualBurstWarningLevels": { "type": "integer", "minimum": 1 },
        "batchCommandMaxLevels": { "type": "integer", "minimum": 1 }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "type": "object", "required": ["key", "name", "icon", "color", "use"] }
    },
    "prestige": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planetTargetDepth", "galaxyTargetPlanets", "rewardStep", "historyLimit", "openingBurstSeconds", "legacyCorePrices", "upgrades"],
      "properties": {
        "planetTargetDepth": { "type": "number", "exclusiveMinimum": 0 },
        "galaxyTargetPlanets": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "openingBurstSeconds": { "const": 1 },
        "legacyCorePrices": {
          "type": "object",
          "additionalProperties": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": { "type": "integer", "minimum": 1 }
          }
        },
        "rewardStep": { "type": "integer", "minimum": 1 },
        "historyLimit": { "type": "integer", "minimum": 1 },
        "upgrades": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["key", "name", "description", "unlockResets", "baseCost", "costGrowth", "maxLevel", "effectKind", "effectPerLevel"],
            "properties": {
              "key": { "type": "string" }, "name": { "type": "string" }, "description": { "type": "string" },
              "unlockResets": { "type": "integer", "minimum": 1 },
              "baseCost": { "type": "integer", "minimum": 1 }, "costGrowth": { "type": "integer", "minimum": 1 },
              "maxLevel": { "type": "integer", "minimum": 1, "maximum": 20 },
              "effectKind": { "enum": ["speed_strength", "income_strength", "depth_strength", "equipment_strength", "line_synergy", "global_speed", "global_linear", "local_discount", "completion_depth", "opening_burst"] },
              "effectPerLevel": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "eras": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "object", "required": ["key", "name", "short", "unlockDepth", "previousEraAutomations", "status"] }
    },
    "multiplierRegions": {
      "type": "array",
      "minItems": 12,
      "items": { "type": "object", "required": ["key", "name", "scope", "formula", "status", "note"] }
    },
    "upgrades": {
      "type": "array",
      "minItems": 18,
      "items": {
        "type": "object",
        "required": ["key", "name", "era", "region", "description", "effectKind", "effectPerLevel", "maxLevel", "baseCost", "costGrowth", "unlockDepth", "prerequisites", "manualTarget", "status"],
        "properties": { "addedIn": { "const": "thirty-day" } }
      }
    },
    "strategy": {
      "type": "object",
      "required": ["mode", "profiles", "priority", "routeVariants", "opportunityCheckIntervalMinutes"]
    }
  }
}
